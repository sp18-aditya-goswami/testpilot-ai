# AI provider for planning and failure analysis. Easiest: set it in the app's Settings page instead.
# Without one, the contract and fuzz engines still run.
# TESTPILOT_AI_PROVIDER=anthropic        # anthropic | openai | bedrock
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Bedrock uses your normal AWS credentials (aws configure, SSO, or env vars) plus a region:
# AWS_REGION=us-east-1

# Optional overrides (defaults shown)
# TESTPILOT_MODEL=claude-opus-5-5
# TESTPILOT_EFFORT=medium
# Hosts TestPilot may send requests to. Add staging hosts only, never production.
# TESTPILOT_ALLOWED_HOSTS=localhost,127.0.0.1
# TESTPILOT_MAX_CONCURRENCY=4
# TESTPILOT_MAX_REQUESTS_PER_RUN=300
# TESTPILOT_REQUEST_TIMEOUT_S=10
